<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        聚合根：只做三件事——锁版本、统一编译参数、声明模块。
        不放任何依赖与插件执行：packaging=pom 的模块绑 spring-boot-maven-plugin 会在 package 阶段失败。
        新增 MCP 服务时，在 backend/mcp-server 下加模块即可，不需要动这个文件。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.13</version>
        <relativePath/>
    </parent>

    <groupId>com.advisory</groupId>
    <artifactId>backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>backend</name>
    <description>Advisory platform aggregator: advisory-server + mcp-server</description>

    <modules>
        <module>advisory-server</module>
        <module>mcp-server</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 全仓库统一的 Spring AI 版本；advisory-server 与 weather-mcp 必须一致，
             因为两边都依赖 spring-ai 的 MCP 协议实现（客户端/服务端需同代）。 -->
        <spring-ai.version>1.0.9</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
