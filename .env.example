# 环境变量示例：复制为 `.env` 后按需修改（`.env` 已被 git 忽略）
# Docker Compose 与本地 `mvn spring-boot:run` 都会读取这些变量。

# ---- PostgreSQL ----
DB_NAME=advisory
DB_URL=jdbc:postgresql://localhost:5432/advisory
DB_USER=advisory
DB_PASSWORD=advisory

# ---- MinIO ----
# 服务端访问 MinIO 的地址（容器内为 http://minio:9000）
MINIO_ENDPOINT=http://localhost:9000
# 浏览器上传时使用的地址：预签名 URL 会按这个 host 签名，必须客户端可达。
# 本地 compose 默认 http://localhost:9000；生产填对外域名，如 https://files.example.com
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=advisory

# ---- 安全 ----
# JWT 签名密钥：生产环境必须替换为至少 32 字节的随机值
JWT_SECRET=dev-only-secret-change-me-32bytes-min
# 敏感字段（提供商 API Key）加密密钥：必须为 32 字节
APP_ENCRYPTION_KEY=dev-only-32-byte-key-change-me!!

# ---- 初始管理员 ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ---- 对话模型上下文 ----
# Ollama 请求里的 num_ctx，同时也是编排器裁剪检索证据时用的窗口（两处共用一个值）。
# Ollama 服务端默认只有 4096，跨轮累积的证据很容易触发
# `request (xxxx tokens) exceeds the available context size (4096 tokens)`。
# 显存紧张时调小（会同时收紧提示词预算），换用大窗口模型时调大。
CHAT_CONTEXT_WINDOW_TOKENS=8192

# ---- 天气 MCP 服务（weather-mcp）----
# open-meteo = 真实数据（需公网）；stub = 固定假数据，供离线开发与测试
WEATHER_PROVIDER=open-meteo
